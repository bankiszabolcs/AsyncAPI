# Másold le .env-re és töltsd ki az értékeket.
# A .env soha nem kerül gitbe — csak ez a példa fájl!

# ── Szerver ──────────────────────────────────────────────────────
# Egyelőre az Oracle Cloud publikus IP-je (pl. 152.67.1.2)
# Ha domain + HTTPS lesz: ide kerül a domain (pl. clipo.example.com)
DOMAIN=

# ── Adatbázis (Postgres) ─────────────────────────────────────────
# DB_USER=postgres — a 00_create_databases.sql az app és a keycloak db-t
# is létrehozza; mindkettőhöz ugyanez a user fér hozzá.
DB_NAME=asyncapi
DB_USER=postgres
DB_PASSWORD=change_me_strong_password

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_password

# ── MinIO (objektum tároló) ──────────────────────────────────────
MINIO_ROOT_USER=clipoadmin
MINIO_ROOT_PASSWORD=change_me_strong_password

# ── Keycloak ─────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_password

# ── E-mail relay (Brevo) ─────────────────────────────────────────
SMTP_USERNAME=your_brevo_username
SMTP_PASSWORD=your_brevo_smtp_key

# ── Gemini AI (opcionális — ha üres, a tag-generálás ki van kapcsolva) ──
AI__GeminiApiKey=
