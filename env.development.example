# Brevo SMTP relay — másold le env.development-be és töltsd ki
# Brevo credentials: app.brevo.com → SMTP & API → SMTP
SMTP_USERNAME=sajat@gmail.com        # Brevo fiókhoz használt email
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # Brevo SMTP kulcs (NEM a Brevo jelszó!)
SMTP_FROM=sajat@gmail.com           # From cím (bármilyen domain lehet)
SMTP_DOMAIN=gmail.com               # Csak a domain rész (pl. gmail.com vagy sajatdomain.hu)
